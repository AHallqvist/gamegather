PORT=3000
DATABASE_PATH=/data/gamegather.db
BASE_URL=http://localhost:3000

EMAIL_ENABLED=true
DISCORD_ENABLED=false
SMS_ENABLED=false
TELEGRAM_ENABLED=false
# Required when DISCORD_ENABLED=true. Invite with bot + applications.commands scopes.
DISCORD_BOT_TOKEN=replace-with-discord-bot-token
DISCORD_GUILD_ID=1554629817159393291

# Mailjet SMTP relay. Replace placeholders locally; never commit real credentials.
MAILJET_SMTP_HOST=in-v3.mailjet.com
MAILJET_SMTP_PORT=587
MAILJET_SMTP_USERNAME=replace-with-mailjet-subaccount-api-key
MAILJET_SMTP_PASSWORD=replace-with-mailjet-subaccount-secret-key
MAIL_FROM_ADDRESS=gamegather@hallqvist.win

# Required when SMS_ENABLED=true. SMS targets must be Swedish mobile numbers (+46).
VONAGE_API_KEY=replace-with-vonage-api-key
VONAGE_API_SECRET=replace-with-vonage-api-secret
VONAGE_SMS_FROM=GameGather

# Required when TELEGRAM_ENABLED=true. Users must open the bot and press Start.
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_BOT_USERNAME=gamegather_notifications_bot
